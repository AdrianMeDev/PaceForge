{
	auto_https off
	admin off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	handle {
		route {
			try_files {path} /index.html

			@no_cache path /index.html /ngsw.json /ngsw-worker.js /manifest.webmanifest
			header @no_cache Cache-Control "no-cache"

			@immutable_assets path_regexp ^/.*-[0-9A-Za-z_-]{8,}\.(js|css)$
			header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

			file_server
		}
	}
}
