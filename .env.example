# Local development configuration. Copy to .env (git-ignored) and adjust.
# Never put real secrets into this file.

DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by compose.dev.yaml (db service)
POSTGRES_USER=paceforge
POSTGRES_PASSWORD=paceforge-dev
POSTGRES_DB=paceforge

# Used by Django; must match the POSTGRES_* values above
DATABASE_URL=postgres://paceforge:paceforge-dev@localhost:5432/paceforge

# Origins allowed to send CSRF-protected requests (needed when the SPA runs on another origin)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200

# Outgoing email. Without SMTP_HOST, emails are printed to the console.
# These values point at the Mailpit service from compose.dev.yaml (UI: http://localhost:8025).
DEFAULT_FROM_EMAIL=PaceForge <noreply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false

# Registration: closed | invite_only (default) | open
REGISTRATION_MODE=invite_only
INVITATION_TTL_DAYS=7

# How many weeks of activities a sync from Intervals.icu reads (8 to 12, default 12)
INTERVALS_SYNC_WEEKS=12

# Background jobs: sync every N hours (1 to 24), review and draft from this hour on Sunday in the
# user's time zone (0 to 23), and look for due jobs every N minutes (1 to 60)
JOBS_SYNC_HOURS=6
JOBS_SUNDAY_HOUR=18
JOBS_INTERVAL_MINUTES=15

# Instance key for secrets stored in the database (comma separated for key rotation).
# Generate with: cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
