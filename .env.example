# Local development configuration. Copy to .env (git-ignored) and adjust.
# Never put real secrets into this file.

DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by compose.dev.yaml (db service)
POSTGRES_USER=paceforge
POSTGRES_PASSWORD=paceforge-dev
POSTGRES_DB=paceforge

# Used by Django; must match the POSTGRES_* values above
DATABASE_URL=postgres://paceforge:paceforge-dev@localhost:5432/paceforge
