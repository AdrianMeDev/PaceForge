# Production settings. Copy to .env next to compose.prod.yaml and fill in every empty value.
# Never commit .env. Generate secrets with the commands shown below.

# --- Domain ---
# Public host name without scheme or path. It must point to this host (ports 80 and 443 open).
APP_DOMAIN=

# --- Secrets ---
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# A Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several keys may be separated by commas (the first one encrypts, all of them decrypt).
ENCRYPTION_KEY=

# --- PostgreSQL ---
# The password is part of DATABASE_URL, so use letters and digits only.
POSTGRES_USER=paceforge
POSTGRES_PASSWORD=
POSTGRES_DB=paceforge

# --- Registration ---
# invite_only: only invited people can register. closed: nobody can register.
REGISTRATION_MODE=invite_only
INVITATION_TTL_DAYS=7

# --- Email (invitations, password reset) ---
# Leave SMTP_HOST empty to write emails to the log instead of sending them.
DEFAULT_FROM_EMAIL=PaceForge <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- AI ---
# Comma-separated base URLs that athletes may use for a custom AI endpoint. Empty means none.
AI_ALLOWED_BASE_URLS=

# --- Scheduler ---
# Hours between Intervals.icu syncs (1 to 24).
JOBS_SYNC_HOURS=6
# Hour of the Sunday review and draft (0 to 23).
JOBS_SUNDAY_HOUR=18
# Minutes between scheduler checks (1 to 60).
JOBS_INTERVAL_MINUTES=15

# --- Backups ---
# Uncomment to run the backup service (docker compose -f compose.prod.yaml up -d).
# COMPOSE_PROFILES=backup
# One or more urlsafe base64 keys of 32 bytes, separated by commas (the first one encrypts, all of
# them decrypt): python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy outside this host; without the key a backup cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Hours between backups (1 to 168).
BACKUP_INTERVAL_HOURS=24
# How many daily and weekly backups are kept.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Gunicorn and migrations ---
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=240
# Set to false to run migrations yourself (docker compose run --rm backend python manage.py migrate).
AUTO_MIGRATE=true
